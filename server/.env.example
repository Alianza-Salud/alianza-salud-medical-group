# =============================================
# Alianza Salud Medical Group — Variables de Entorno
# =============================================
# Copiar este archivo como .env y completar los valores.
# NO incluir el archivo .env real en el repositorio.

# --- Servidor ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# --- Base de Datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=alianza_salud

# --- Autenticación JWT ---
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
AUTH_COOKIE_MAX_AGE_MS=900000
TRUST_PROXY=false
VERIFICATION_CODE_PEPPER=replace_with_an_independent_long_random_secret

# --- Almacenamiento de Documentos (StorageService) ---
# Opciones para STORAGE_DRIVER: 'local' (almacenamiento privado local) o 's3' (Nube)
STORAGE_DRIVER=local

# Configuración Nube S3 / Cloudflare R2 / MinIO / Wasabi / DigitalOcean / Supabase
S3_BUCKET=tu-bucket-alianza-salud
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tu_access_key_id
S3_SECRET_ACCESS_KEY=tu_secret_access_key
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  # Solo para Cloudflare R2, MinIO o Supabase

# --- Integración Google Calendar API & Google Meet ---
# Opción A: Autenticación OAuth2 de Cuenta Organizadora (Recomendada)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REFRESH_TOKEN=tu_google_refresh_token
GOOGLE_CALENDAR_ID=primary

# Opción B: Autenticación mediante Service Account con delegación de dominio (Opcional)
GOOGLE_SERVICE_ACCOUNT_EMAIL=cuenta-servicio@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada\n-----END PRIVATE KEY-----"

